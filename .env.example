# PostgreSQL (lokalnie: docker compose up -d db)
DATABASE_URL="postgresql://sds:sds@localhost:55432/sds?schema=public"
# Na localhost bez HTTPS ciasteczko sesji nie może mieć flagi Secure
SESSION_COOKIE_SECURE="false"
# Konto administratora tworzone przez seed, gdy baza nie ma użytkowników
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin-change-me"
