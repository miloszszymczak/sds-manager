# Skopiuj do .release.env (plik jest w .gitignore) i uzupełnij.
# Rejestr i nazwa obrazu (bez taga), np. ghcr.io/twoj-login/sds-app albo registry.example.com/sds/sds-app
IMAGE_REPO=
# Architektury obrazu: linux/amd64 | linux/arm64 | linux/amd64,linux/arm64
PLATFORMS=linux/amd64
# Zdalne repozytorium i gałąź wydań
GIT_REMOTE=origin
RELEASE_BRANCH=master
